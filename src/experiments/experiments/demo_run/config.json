{
  "dataset_name": "cifar10",
  "num_labeled": 1000,
  "data_root": "./data",
  "architecture": "cnn13",
  "num_classes": 10,
  "dropout_rate": 0.0,
  "batch_size": 64,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "warmup_epochs": 10,
  "rlgssl_epochs": 20,
  "total_epochs": 450,
  "lambda_sup": 0.1,
  "lambda_cons": 0.1,
  "ema_decay": 0.999,
  "mixup_alpha": 1.0,
  "use_adaptive_rl": true,
  "confidence_threshold": 0.8,
  "entropy_regularization": 0.01,
  "eval_frequency": 5,
  "save_frequency": 50,
  "log_frequency": 10,
  "use_tensorboard": true,
  "device": "cuda",
  "num_workers": 4,
  "use_amp": true,
  "experiment_name": "demo_run",
  "save_dir": "./experiments",
  "seed": 42
}